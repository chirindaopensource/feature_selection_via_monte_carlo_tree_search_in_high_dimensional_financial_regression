  "eq1_policy": {
    "eq_number": 1,
    "equation_form": "pi(a_k | s) = exp(w_{s,a_k}/tau + beta_{s,a_k}) / sum_j exp(w_{s,a_j}/tau + beta_{s,a_j})",
    "policy_weight_symbol": "W",
    "policy_matrix_size": [
      1072,
      1072
    ],
    "policy_matrix_entries_total": 1149184,
    "policy_matrix_data_type": "float64",
    "policy_initialization": "zero_uniform",
    "policy_initialization_alternatives": [
      "zero_uniform",
      "random_normal_sigma_0_01",
      "random_normal_sigma_0_1"
    ],
    "temperature_symbol": "tau",
    "temperature_value_fixed": 1.52,
    "temperature_value_tuned": 0.868,
    "temperature_value_endogenous": 1.515,
    "parameter_identification_note": "beta_mag and tau identified only up to their ratio through the learned channel",
    "action_masking_applied": true,
    "sampling_mechanism": "single_categorical_draw",
    "sampling_label_in_paper": "Gibbs Sampling Selection",
    "terminology_caveat": "mechanically a single categorical draw from a softmax distribution, NOT MCMC Gibbs",
    "reference_keys": [
      "cazenave2020generalized",
      "rosin2011nested",
      "cazenave2017nested"
    ]
  },
  "eq2_adaptation": {
    "eq_number": 2,
    "equation_form": "w_{s,a_j} <- w_{s,a_j} - (alpha/tau) * (pi(a_j|s) - I{a_j = a*})",
    "update_target_symbol": "a*",
    "update_target_semantic": "action taken in the best rollout sequence retained at this level",
    "effective_step_size": "alpha/tau",
    "step_direction_for_best_action": "increase w",
    "step_direction_for_other_actions": "decrease w",
    "alpha_L1_value_endogenous": 0.177,
    "alpha_L1_value_fixed": 1.514,
    "alpha_L1_value_tuned": 2.003,
    "alpha_high_value_endogenous": 2.212,
    "alpha_routing_rule": "alpha = alpha_L1 if L == 1 else alpha_high",
    "uses_value_function": false,
    "uses_advantage_estimate": false,
    "uses_temporal_difference": false,
    "uses_bootstrapping": false,
    "update_type": "policy-gradient-style softmax update with one-hot target"
  },
  "eq3_target_and_partition": {
