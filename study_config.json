      "adaptive_endogenous"
    ]
  },
  "eq5_mdp": {
    "eq_number": 5,
    "equation_form": "A(s_t) = (F \\ S_t) union {a_stop}",
    "mdp_tuple": "(S, A, R)",
    "feature_universe_symbol": "F",
    "feature_universe_size": 1072,
    "state_definition": "(f_last, S_t)",
    "initial_state": "(f_last=None, S_0=set())",
    "state_space_nominal": "p * 2^p",
    "state_space_factored": "p^2 + p",
    "action_types": [
      "add_feature",
      "stop"
    ],
    "stop_action_symbol": "a_stop",
    "transition": "S_{t+1} = S_t union {a}; f_last <- a",
    "transition_monotonicity": "support_non_decreasing_no_removal_no_swap",
    "terminal_conditions": [
      "a_stop_selected",
      "cardinality_equals_K_max"
    ],
    "reward_timing": "terminal_only",
    "reward_is_delayed": true,
    "reward_is_discounted": false,
    "reward_is_summed": false
  },
  "eq6_fit": {
    "eq_number": 6,
    "equation_form": "theta_hat_S = (X_{train,S}^T X_{train,S} + lambda I)^{-1} X_{train,S}^T Y_train",
    "estimator_type": "ridge_stabilized_OLS",
    "shrinkage_applied": false,
    "stabilizer_symbol": "lambda",
    "stabilizer_value": 1e-05,
    "stabilizer_role": "numerical stability only",
    "linear_algebra_backend": "NumPy",
    "gram_matrix_inversion_method": "np.linalg.solve_gram_with_I",
    "gram_matrix_fallback": "np.linalg.pinv",
    "fit_dataset": "train_block",
    "score_dataset": "internal_validation_562_days",
    "final_eval_dataset": "test_block_562_days"
  },
  "eq7_redundancy": {
    "eq_number": 7,
    "equation_form": "Red_{top-k-rms}(f_i,S) = ((1/min(k,|S|)) * sum_{m=1..min(k,|S|)} c_(m)^2)^{1/2}",
    "correlation_type": "sample_Pearson",
    "relevance_formula": "Rel(f_i) = |rho(f_i, Y)|",
    "redundancy_pool_formula": "C_{i,S} = {|rho(f_i, f_j)| : f_j in S}",
    "order_statistic_definition": "c_(m) = m-th largest element of C_{i,S}",
    "k_endogenous": 3,
    "metric_settings": [
      "mean",
      "rms",
      "top-3-rms"
    ],
    "metric_assignment_fixed": "mean",
    "metric_assignment_tuned": "rms",
    "metric_assignment_endogenous": "top-3-rms",
    "variant_mean_formula": "Red_mean(f_i,S) = (1/|S|) * sum_{m=1..|S|} c_(m)^2",
    "variant_rms_formula": "Red_rms(f_i,S) = ((1/|S|) * sum_{m=1..|S|} c_(m)^2)^{1/2}",
    "correlation_estimation_window": "train_window_full_1890_or_1000_days_by_config",
    "correlation_estimation_window_alternatives": [
      "train_window_full",
      "expanding_from_train_start",
      "rolling_252_days"
    ]
  },
  "eq8_feature_bias": {
    "eq_number": 8,
    "equation_form": "beta(f_i|S) = beta_mag * [gamma * Rel(f_i) - (1-gamma) * Red_{top-k-rms}(f_i,S)]",
    "gamma_domain": [
      0.0,
      1.0
    ],
    "gamma_value_fixed": 0.666,
    "gamma_value_tuned": 0.772,
    "gamma_value_endogenous": 0.811,
    "beta_mag_value_fixed": 24.82,
    "beta_mag_value_tuned": 14.97,
    "beta_mag_value_endogenous": 13.72
  },
  "eq9_stop_gravity": {
    "eq_number": 9,
    "equation_form_cases": [
      "beta(a_stop|S) = -inf if |S| < K_min",
      "beta(a_stop|S) = beta_mag * gamma * beta_stop * ((|S|-K_min)/max(1,K_max-|S|))^{3/2} if |S| >= K_min"
    ],
    "K_min_symbol": "K_min",
    "K_min_value": 5,
    "K_min_resolution_rationale": "Chosen as the lower bound of the candidate set most consistent with the endogenous mean size 18.6 and tuned target 15.",
    "K_max_symbol": "K_max",
    "K_max_value": 60,
    "exponent_value": 1.5,
    "exponent_rationale": "empirically chosen constant per paper",
    "beta_stop_value_endogenous": 0.909,
    "beta_stop_value_fixed": null,
    "beta_stop_value_tuned": null,
    "convexity_property": "bias grows convexly as |S| approaches K_max",
    "fixed_cardinality_enforcement_mechanism": "hard_mask_stop_until_cardinality_equals_K",
    "fixed_cardinality_enforcement_description": "For fixed and tuned configurations, set beta(a_stop|S) = -inf until |S| = K, then set beta(a_stop|S) = 0; equivalently K_min = K_max = K."
  },
  "eq10_reward": {
    "eq_number": 10,
    "equation_form": "R(S) = (round(R2_val(S), 3), -|S|, -MaxVIF(S))",
    "primary_key": "rounded_validation_R2",
    "primary_key_rounding_places": 3,
    "primary_key_rounding_operator": "round_half_away_from_zero",
    "secondary_key": "-|S|",
    "secondary_key_semantic": "prefer smaller subsets among ties",
    "tertiary_key": "-MaxVIF(S)",
    "tertiary_key_semantic": "prefer lower internal multicollinearity among residual ties",
    "comparison_operator": "lexicographic_strict_greater_than",
    "quantization_note": "3-decimal rounding manufactures ties that activate the lower keys",
    "reward_scalarization_active": false
  },
  "eq11_maxvif": {
    "eq_number": 11,
    "equation_form": "MaxVIF(S) = max_{j in [1..|S|]} (C_S^{-1})_{jj}",
    "correlation_matrix_symbol": "C_S",
    "correlation_matrix_shape": "(|S|, |S|)",
    "role": "tie_breaker_inside_lexicographic_reward",
    "correlation_matrix_fit_on": "validation_subset",
    "singular_handling": "moore_penrose_pseudoinverse",
