  "interpretive_contract": {
    "task_type": "contemporaneous explanatory regression",
    "task_target": "weekly NASDAQ-100 return (5-day rolling sum)",
    "task_statement": "explaining, rather than forecasting, the weekly NASDAQ-100 return",
    "R2_interpretation": "explanatory, not predictive",
    "economic_mechanism_cited": "leverage effect (Black, 1976)",
    "contemporaneous_alignment_rationale": "Y_t aggregates 5 days while some predictors are 1-day changes; model captures same-day and near-term co-movement — deliberate, not oversight",
    "regime_adjacency_tradeoff": "Validation window placed immediately before test to maximize regime similarity; trades weaker protection against regime change",
    "optimizer_curse_explanation": "CV-to-test gap (up to 0.7607 CV vs. 0.643-0.668 true test) is the expected signature of argmax selection over noisy trials; not leakage",
    "headline_R2_gnrpa_endogenous_ensemble": 0.6961,
    "headline_R2_lasso_baseline": 0.6313,
    "headline_improvement_absolute": 0.0648,
    "headline_feature_universe_size": 1072
  },
