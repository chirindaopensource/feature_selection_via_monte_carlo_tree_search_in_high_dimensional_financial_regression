  "eq4_objective": {
    "eq_number": 4,
    "equation_form": "min_theta (1/(2*N_train)) ||Y_train - X_{train,S} theta||_2^2  s.t. ||theta||_0 <= K",
    "residual_norm_order": 2,
    "cardinality_norm_order": 0,
